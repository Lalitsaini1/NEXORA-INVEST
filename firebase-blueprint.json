        "action": { "type": "string", "minLength": 2, "maxLength": 120 },
        "details": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["logId", "uid", "category", "action", "details", "createdAt"]
    },
    "AdminActivityLog": {
      "title": "AdminActivityLog",
