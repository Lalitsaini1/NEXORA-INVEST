{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated member or admin profile with backend-governed permanent NX User ID and zero plaintext credentials.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Permanent unique NEXORA User ID (e.g., NX100001).",
          "minLength": 8,
          "maxLength": 16,
          "pattern": "^NX[0-9]{6,10}$"
        },
        "role": {
          "type": "string",
          "enum": ["USER", "ADMIN", "SUPER_ADMIN"],
          "description": "User authorization role."
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "mobile": {
          "type": "string",
          "maxLength": 20
        },
        "emailVerified": {
          "type": "boolean"
        },
        "mobileVerified": {
          "type": "boolean"
        },
        "authProvider": {
          "type": "string",
          "enum": ["password", "phone", "password+phone"]
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "SUSPENDED", "PENDING_VERIFICATION"]
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 100000,
          "description": "Optional compressed square profile avatar data URL."
        },
        "referredByCode": {
          "type": "string",
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "userId",
        "role",
        "fullName",
        "email",
        "mobile",
        "emailVerified",
        "mobileVerified",
        "authProvider",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "IdentityLock": {
      "title": "IdentityLock",
      "description": "Hashed uniqueness lock preventing duplicate email or mobile registrations without exposing PII.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["EMAIL", "MOBILE"]
        },
        "valueHash": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["type", "valueHash", "uid", "createdAt"]
    },
    "SystemCounter": {
      "title": "SystemCounter",
      "description": "Monotonic sequence counter enforcing atomic NX User ID allocation.",
      "type": "object",
      "properties": {
        "nextNumber": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["nextNumber", "updatedAt"]
    },
    "CoinWallet": {
      "title": "CoinWallet",
      "description": "Segregated virtual coin wallet initialized at zero balances upon verified registration.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 16,
          "pattern": "^NX[0-9]{6,10}$"
        },
        "availableCoins": {
          "type": "integer"
        },
        "purchasedCoins": {
          "type": "integer"
        },
        "earnedCoins": {
          "type": "integer"
        },
        "coinsUsedForPlans": {
          "type": "integer"
        },
        "pendingTransactionCoins": {
          "type": "integer"
        },
        "withdrawableBalanceInr": {
          "type": "integer"
        },
        "lastWithdrawalRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lastPlanRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "userId",
        "availableCoins",
        "purchasedCoins",
        "earnedCoins",
        "coinsUsedForPlans",
        "pendingTransactionCoins",
        "withdrawableBalanceInr",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Trusted administrator directory separating SUPER_ADMIN and ADMIN tiers.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["ADMIN", "SUPER_ADMIN"]
        },
        "active": {
          "type": "boolean"
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "active", "createdAt"]
    },
    "CoinTransaction": {
      "title": "CoinTransaction",
      "description": "Immutable virtual coin ledger entry recording deposits, plan investments, daily rewards, and withdrawals.",
      "type": "object",
      "properties": {
        "transactionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 16,
          "pattern": "^NX[0-9]{6,10}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "COIN_PURCHASE",
            "PLAN_INVESTMENT",
            "DAILY_REWARD",
            "WITHDRAWAL_REQUEST",
            "WITHDRAWAL_REFUND",
            "ADMIN_ADJUSTMENT"
          ]
        },
        "assetType": {
          "type": "string",
          "enum": ["COINS", "INR"]
        },
        "amount": {
          "type": "integer"
        },
        "previousBalance": {
          "type": "integer"
        },
        "newBalance": {
          "type": "integer"
        },
        "referenceId": {
          "type": "string",
          "maxLength": 128
        },
        "idempotencyKey": {
          "type": "string",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "COMPLETED", "REJECTED", "FAILED"]
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "transactionId",
        "uid",
        "userId",
        "type",
        "amount",
        "previousBalance",
        "newBalance",
        "referenceId",
        "idempotencyKey",
        "status",
        "description",
        "createdAt"
      ]
    },
    "UserPlan": {
      "title": "UserPlan",
      "description": "User enrollment in a structured product-based virtual coin cycle.",
      "type": "object",
      "properties": {
        "userPlanId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
