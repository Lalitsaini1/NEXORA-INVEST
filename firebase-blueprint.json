        "scheduledFor": { "type": "string", "format": "date-time" },
        "creditedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "rewardId",
        "userPlanId",
        "uid",
        "userId",
        "rewardDayNumber",
        "coinsCredited",
        "scheduledFor",
        "creditedAt"
      ]
    },
    "ReferralCode": {
      "title": "ReferralCode",
      "description": "Maps a member permanent NX referral code to their Firebase UID without leaking PII.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 8, "maxLength": 16, "pattern": "^NX[0-9]{6,10}$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "ownerUid", "createdAt"]
    },
    "ReferralRecord": {
      "title": "ReferralRecord",
      "description": "Anonymized referral attribution link for successful member sign-ups.",
      "type": "object",
      "properties": {
        "referralId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "referrerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "referrerCode": { "type": "string", "minLength": 8, "maxLength": 16, "pattern": "^NX[0-9]{6,10}$" },
        "referredUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "referredUserId": { "type": "string", "minLength": 8, "maxLength": 16, "pattern": "^NX[0-9]{6,10}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["referralId", "referrerUid", "referrerCode", "referredUid", "referredUserId", "createdAt"]
    },
    "UserActivityLog": {
      "title": "UserActivityLog",
      "description": "Append-only user security and account activity log.",
      "type": "object",
