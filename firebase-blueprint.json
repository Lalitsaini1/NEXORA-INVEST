        "creditLockId": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "utrLockId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "verificationMethod": { "type": "string", "enum": ["ADMIN_SETTLEMENT", "WEBHOOK_PLACEHOLDER", "WEBHOOK_VERIFIED"] },
        "webhookVerificationStatus": {
          "type": "string",
          "enum": ["NOT_RECEIVED", "PLACEHOLDER_VERIFIED", "SIGNATURE_VERIFIED", "SIGNATURE_REJECTED", "DUPLICATE_IGNORED"]
        },
        "lastWebhookEventId": { "type": "string", "maxLength": 128 },
        "status": {
          "type": "string",
          "enum": ["INITIATED", "PENDING_VERIFICATION", "WEBHOOK_VERIFIED", "CREDITED", "DUPLICATE_BLOCKED", "FAILED", "REJECTED"]
