        "coinTransactionId": { "type": "string", "maxLength": 128 },
        "failureReason": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "creditedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "paymentTxId",
        "depositId",
        "uid",
        "userId",
        "provider",
        "amountInr",
        "coinsToCredit",
        "currency",
        "idempotencyKey",
        "creditLockId",
        "verificationMethod",
        "webhookVerificationStatus",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "PaymentCreditLock": {
      "title": "PaymentCreditLock",
      "description": "Write-once deterministic idempotency lock preventing duplicate coin credits for the same deposit, UTR reference, or gateway payment.",
      "type": "object",
      "properties": {
        "lockId": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lockScope": { "type": "string", "enum": ["DEPOSIT_ORDER", "UTR_REFERENCE", "GATEWAY_PAYMENT"] },
        "paymentTxId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "depositId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 8, "maxLength": 16, "pattern": "^NX[0-9]{6,10}$" },
        "coinsCredited": { "type": "integer" },
        "coinTransactionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "lockId",
        "lockScope",
        "paymentTxId",
        "depositId",
        "uid",
        "userId",
        "coinsCredited",
        "coinTransactionId",
        "createdByUid",
        "createdAt"
      ]
    },
    "PaymentWebhookEvent": {
      "title": "PaymentWebhookEvent",
      "description": "Immutable webhook verification audit event generated by the placeholder or live payment webhook verification service.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "gatewayEventId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "provider": {
          "type": "string",
          "enum": ["UPI_GATEWAY", "RAZORPAY", "CASHFREE", "PHONEPE_PG", "PAYTM_PG", "PLACEHOLDER_WEBHOOK"]
        },
        "paymentTxId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "depositId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "utrReference": { "type": "string", "maxLength": 36 },
        "amountInr": { "type": "integer" },
        "signaturePresent": { "type": "boolean" },
        "computedDigestPreview": { "type": "string", "maxLength": 128 },
        "verificationStatus": {
          "type": "string",
          "enum": ["PLACEHOLDER_HOLD", "VERIFIED_READY_FOR_CREDIT", "DUPLICATE_IGNORED", "SIGNATURE_INVALID", "FAILED"]
        },
        "isLiveGatewayActive": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 300 },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "eventId",
        "gatewayEventId",
        "provider",
        "paymentTxId",
        "depositId",
        "amountInr",
        "signaturePresent",
        "computedDigestPreview",
        "verificationStatus",
        "isLiveGatewayActive",
        "note",
        "actorUid",
        "createdAt"
      ]
    },
    "UserPayoutMethod": {
      "title": "UserPayoutMethod",
      "description": "Member-owned UPI ID or Bank Account destination gated by ownership verification before real-money withdrawals.",
      "type": "object",
      "properties": {
        "methodId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 8, "maxLength": 16, "pattern": "^NX[0-9]{6,10}$" },
        "methodType": { "type": "string", "enum": ["UPI", "BANK_ACCOUNT"] },
        "label": { "type": "string", "minLength": 2, "maxLength": 60 },
        "upiId": { "type": "string", "minLength": 5, "maxLength": 100 },
        "upiProvider": { "type": "string", "maxLength": 40 },
        "accountHolderName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "bankName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "accountNumber": { "type": "string", "minLength": 9, "maxLength": 18, "pattern": "^[0-9]{9,18}$" },
        "accountNumberMasked": { "type": "string", "minLength": 4, "maxLength": 32 },
        "accountLast4": { "type": "string", "minLength": 4, "maxLength": 4, "pattern": "^[0-9]{4}$" },
        "ifscCode": { "type": "string", "minLength": 11, "maxLength": 11, "pattern": "^[A-Z]{4}0[A-Z0-9]{6}$" },
        "accountType": { "type": "string", "enum": ["SAVINGS", "CURRENT"] },
        "isDefault": { "type": "boolean" },
        "verificationStatus": { "type": "string", "enum": ["PENDING_VERIFICATION", "VERIFIED", "REJECTED"] },
        "verificationMethod": { "type": "string", "enum": ["ADMIN_REVIEW", "OWNERSHIP_CONFIRMED"] },
        "verificationNote": { "type": "string", "maxLength": 300 },
        "verifiedByAdminUid": { "type": "string", "maxLength": 128 },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "methodId",
        "uid",
        "userId",
        "methodType",
        "label",
        "isDefault",
        "verificationStatus",
        "verificationMethod",
        "createdAt",
        "updatedAt"
      ]
    },
    "WithdrawalRequest": {
      "title": "WithdrawalRequest",
      "description": "User withdrawal request linked to a verified UPI or masked Bank Account payout method and admin settlement status.",
      "type": "object",
      "properties": {
        "withdrawalId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 8, "maxLength": 16, "pattern": "^NX[0-9]{6,10}$" },
        "amountInr": { "type": "integer" },
        "payoutMethodId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "payoutMethodType": { "type": "string", "enum": ["UPI", "BANK_ACCOUNT"] },
        "payoutLabel": { "type": "string", "maxLength": 60 },
        "payoutDestinationMasked": { "type": "string", "maxLength": 120 },
        "idempotencyKey": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["PENDING", "PROCESSING", "UNDER_REVIEW", "APPROVED", "REJECTED", "COMPLETED", "PAID"] },
        "remarks": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "paidAt": { "type": "string", "format": "date-time" }
      },
      "required": ["withdrawalId", "uid", "userId", "amountInr", "status", "createdAt", "updatedAt"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Super Admin governed platform configuration, authentication controls, and audit log retention policies.",
      "type": "object",
      "properties": {
        "settingId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "payoutsEnabled": { "type": "boolean" },
        "registrationsEnabled": { "type": "boolean" },
        "supportEmail": { "type": "string", "maxLength": 160 },
        "supportPhone": { "type": "string", "maxLength": 30 },
        "securityNotice": { "type": "string", "maxLength": 300 },
        "requireEmailVerification": { "type": "boolean" },
        "enforceAdminMfaOrOtp": { "type": "boolean" },
        "sessionTimeoutMinutes": { "type": "integer" },
        "maxAdminLoginAttempts": { "type": "integer" },
        "auditLogRetentionDays": { "type": "integer" },
        "upiDepositsEnabled": { "type": "boolean" },
        "minDepositInr": { "type": "integer" },
        "maxDepositInr": { "type": "integer" },
        "coinPackagesCsv": { "type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[0-9]{2,6}(,[0-9]{2,6}){0,7}$" },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["settingId", "payoutsEnabled", "registrationsEnabled", "supportEmail", "supportPhone", "updatedByUid", "updatedAt"]
    },
    "AdminLoginAttempt": {
      "title": "AdminLoginAttempt",
      "description": "Append-only telemetry record of admin portal sign-in outcomes for Super Admin security monitoring.",
      "type": "object",
      "properties": {
        "attemptId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "enum": ["USER", "ADMIN", "SUPER_ADMIN"] },
        "outcome": { "type": "string", "enum": ["SUCCESS", "DENIED_NOT_ADMIN"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["attemptId", "uid", "email", "role", "outcome", "timestamp"]
    },
    "InvestmentRequest": {
      "title": "InvestmentRequest",
      "description": "User-submitted investment intent pending backend payment/balance verification and Cloud Function activation.",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 8, "maxLength": 16, "pattern": "^NX[0-9]{6,10}$" },
        "planId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "planPriceInr": { "type": "integer" },
        "coinCost": { "type": "integer" },
        "durationDays": { "type": "integer" },
        "totalRewardEntitlement": { "type": "integer" },
        "acceptedTerms": { "type": "boolean" },
        "idempotencyKey": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["PENDING_VERIFICATION", "ACTIVATED", "REJECTED", "FAILED"] },
        "paymentStatus": { "type": "string", "enum": ["PENDING", "VERIFIED", "INSUFFICIENT_BALANCE", "FAILED"] },
        "activatedUserPlanId": { "type": "string", "maxLength": 128 },
        "coinTransactionId": { "type": "string", "maxLength": 128 },
        "verifiedByUid": { "type": "string", "maxLength": 128 },
        "failureReason": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "activatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "requestId",
        "uid",
        "userId",
        "planId",
        "productName",
        "planPriceInr",
        "coinCost",
        "durationDays",
        "totalRewardEntitlement",
        "acceptedTerms",
        "idempotencyKey",
        "status",
        "paymentStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "MailQueueDocument": {
      "title": "MailQueueDocument",
      "description": "Outbound email document written exclusively by backend Cloud Functions for processing by Firebase Extension (firestore-send-email).",
      "type": "object",
      "properties": {
        "to": {
          "type": "array",
          "items": { "type": "string" }
        },
        "message": {
          "type": "object",
          "properties": {
            "subject": { "type": "string", "maxLength": 240 },
            "text": { "type": "string" },
            "html": { "type": "string" }
          },
          "required": ["subject", "text", "html"]
        },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 16 },
        "planId": { "type": "string", "maxLength": 64 },
        "referenceId": { "type": "string", "maxLength": 128 },
        "sourceCollection": { "type": "string", "enum": ["userPlans", "investmentRequests"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["to", "message", "uid", "referenceId", "createdAt"]
    },
    "BackendIdempotencyLock": {
      "title": "BackendIdempotencyLock",
      "description": "Server-only write-once idempotency lock created via Firebase Admin SDK inside Cloud Functions to block duplicate requests, plan activations, or withdrawals.",
      "type": "object",
      "properties": {
        "lockId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requestId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["lockId", "uid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores verified user profile metadata and immutable NX User ID."
    },
    "/identityLocks/{lockId}": {
      "schema": { "$ref": "#/entities/IdentityLock" },
      "description": "Hashed email and mobile uniqueness locks."
    },
    "/counters/{counterId}": {
      "schema": { "$ref": "#/entities/SystemCounter" },
      "description": "Atomic sequence counter for NX User ID generation."
    },
    "/coinWallets/{userId}": {
      "schema": { "$ref": "#/entities/CoinWallet" },
      "description": "Segregated virtual coin balances initialized at zero."
    },
    "/coinTransactions/{transactionId}": {
      "schema": { "$ref": "#/entities/CoinTransaction" },
      "description": "Immutable virtual coin ledger for deposits, daily rewards, plan purchases, and withdrawals."
    },
    "/userPlans/{userPlanId}": {
      "schema": { "$ref": "#/entities/UserPlan" },
      "description": "User-owned structured plan enrollments and collected reward progress."
    },
    "/investmentRequests/{requestId}": {
      "schema": { "$ref": "#/entities/InvestmentRequest" },
      "description": "User-submitted investment requests verified and activated exclusively by backend Cloud Functions."
    },
    "/dailyRewards/{rewardId}": {
      "schema": { "$ref": "#/entities/DailyRewardRecord" },
      "description": "Scheduled daily virtual coin reward credit records."
    },
    "/adminUsers/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Trusted administrator directory separating SUPER_ADMIN and ADMIN roles."
    },
    "/referralCodes/{code}": {
      "schema": { "$ref": "#/entities/ReferralCode" },
      "description": "Permanent NX code to UID mapping for referral attribution."
    },
    "/referrals/{referralId}": {
      "schema": { "$ref": "#/entities/ReferralRecord" },
      "description": "PII-free referral sign-up attribution records."
    },
    "/userActivityLogs/{logId}": {
      "schema": { "$ref": "#/entities/UserActivityLog" },
      "description": "Append-only user security and account activity log."
    },
    "/adminActivityLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminActivityLog" },
      "description": "Append-only administrative audit trail."
    },
    "/upiAccounts/{accountId}": {
      "schema": { "$ref": "#/entities/UpiAccount" },
      "description": "Admin-managed UPI payment collection accounts."
    },
    "/productPlans/{planId}": {
      "schema": { "$ref": "#/entities/ProductPlan" },
      "description": "Admin-managed structured product plans."
    },
    "/coinPackages/{packageId}": {
      "schema": { "$ref": "#/entities/CoinPackage" },
      "description": "Admin-defined virtual coin packages with INR pricing and bonus structures."
    },
    "/depositRequests/{depositId}": {
      "schema": { "$ref": "#/entities/DepositRequest" },
      "description": "User coin deposit requests and admin approvals."
    },
    "/paymentTransactions/{paymentTxId}": {
      "schema": { "$ref": "#/entities/PaymentTransaction" },
      "description": "Idempotent payment gateway & UPI settlement tracking records."
    },
    "/paymentCreditLocks/{lockId}": {
      "schema": { "$ref": "#/entities/PaymentCreditLock" },
      "description": "Immutable write-once uniqueness locks preventing duplicate coin credits."
    },
    "/paymentWebhookEvents/{eventId}": {
      "schema": { "$ref": "#/entities/PaymentWebhookEvent" },
      "description": "Append-only payment webhook verification audit log."
    },
    "/userPayoutMethods/{methodId}": {
      "schema": { "$ref": "#/entities/UserPayoutMethod" },
      "description": "Owner-isolated and admin-verified member UPI IDs and masked Bank Accounts."
    },
    "/withdrawalRequests/{withdrawalId}": {
      "schema": { "$ref": "#/entities/WithdrawalRequest" },
      "description": "User withdrawal requests and admin settlement status."
    },
    "/platformSettings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Super Admin platform configuration and security controls."
    },
    "/adminLoginAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/AdminLoginAttempt" },
      "description": "Immutable log of Admin Portal authentication attempts and denied escalation events."
    },
    "/mail/{mailId}": {
      "schema": { "$ref": "#/entities/MailQueueDocument" },
      "description": "Backend-only outbound email queue processed by the Firebase Trigger Email from Firestore extension."
    },
    "/investmentRequestLocks/{lockId}": {
      "schema": { "$ref": "#/entities/BackendIdempotencyLock" },
      "description": "Backend-only idempotency locks enforcing unique investmentRequest creation per idempotency key."
    },
    "/investmentLocks/{lockId}": {
      "schema": { "$ref": "#/entities/BackendIdempotencyLock" },
      "description": "Backend-only idempotency locks enforcing unique plan activation per investment request."
    },
    "/withdrawalLocks/{lockId}": {
      "schema": { "$ref": "#/entities/BackendIdempotencyLock" },
      "description": "Backend-only idempotency locks enforcing unique INR withdrawal submission."
    }
  }
}
