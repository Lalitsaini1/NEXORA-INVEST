        "userId": { "type": "string", "minLength": 8, "maxLength": 16, "pattern": "^NX[0-9]{6,10}$" },
        "planId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "coinCost": { "type": "integer" },
        "durationDays": { "type": "integer" },
        "totalRewardEntitlement": { "type": "integer" },
        "collectedReward": { "type": "integer" },
        "remainingReward": { "type": "integer" },
        "daysCompleted": { "type": "integer" },
        "remainingDays": { "type": "integer" },
        "startDate": { "type": "string", "maxLength": 64 },
        "endDate": { "type": "string", "maxLength": 64 },
        "nextRewardEligibilityTime": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["ACTIVE", "COMPLETED", "CANCELLED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userPlanId",
        "uid",
        "userId",
        "planId",
        "productName",
        "imageUrl",
        "coinCost",
        "durationDays",
        "totalRewardEntitlement",
        "collectedReward",
        "remainingReward",
        "daysCompleted",
        "remainingDays",
        "startDate",
        "endDate",
        "nextRewardEligibilityTime",
        "status",
        "createdAt"
      ]
    },
    "DailyRewardRecord": {
      "title": "DailyRewardRecord",
