    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Backend-ready idempotent payment transaction lifecycle record linked to deposit orders, webhook verification, and atomic credit locks.",
      "type": "object",
      "properties": {
        "paymentTxId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "depositId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
